{
  "manifest_version": 3,
  "name": "Steam Marketplace Full Order List",
  "version": "1.1.0",
  "description": "Click the collapsed \"$X or more\"/\"$X or lower\" row on a Steam Community Market item page to expand the full buy/sell order list in place.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/market/listings/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}